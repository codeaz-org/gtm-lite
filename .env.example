# GTM-Lite secrets — copy to .env for local runs, or add each as a repo secret
# for GitHub Actions (Settings → Secrets and variables → Actions).
#
# Local run:  node --env-file=.env scripts/discover.mjs   (Node 20+, no dotenv needed)

# ── LLM providers (fallback order matches config.yml → models.chat) ─────────
# Set at least ONE. If both are set, OpenRouter is tried first, NIM on failure.
OPENROUTER_API_KEY=          # https://openrouter.ai/keys — free tier, no CC
NVIDIA_API_KEY=              # https://build.nvidia.com — free credits

# ── Lead discovery ─────────────────────────────────────────────────────────
EXA_API_KEY=                 # https://dashboard.exa.ai — $10/mo free credits

# ── Email lookup (optional fallback when site scraping finds nothing) ──────
HUNTER_API_KEY=              # https://hunter.io — 25 domain searches/mo free

# ── Gmail drafts (see README §"Gmail OAuth" for the one-time setup) ────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
